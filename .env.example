# Production application
NODE_ENV=production
PORT=10000
APP_URL=https://weps-backup-center.onrender.com
AUTH_URL=https://weps-backup-center.onrender.com
NEXTAUTH_URL=https://weps-backup-center.onrender.com

# Generate a unique signing secret (min 32 chars). Do not reuse BACKUP_ENCRYPTION_KEY.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Paste the value with no quotes, spaces, or hex: prefix.
AUTH_SECRET=

# Backup Center DB — Render Internal URL for weps-backup-center-db, never localhost
DATABASE_URL=

# Source PostgreSQL — Internal URL of the database being backed up, never localhost
SOURCE_DATABASE_URL=

# Non-production maintenance database on the same source instance.
# Used for CREATE DATABASE and controlled RENAME; it does not grant extra privileges.
SOURCE_MAINTENANCE_DATABASE=postgres

# Production Restore maintenance window and rollback retention are stored in
# SystemSettings and managed in the application Settings page, not in environment variables.
# The rollback retention only delays eligibility for manual deletion; deletion is never automatic.

# Initial Admin (min 12 chars). Changing ADMIN_PASSWORD on Render resets the login hash on next deploy.
ADMIN_EMAIL=admin@weps.local
ADMIN_PASSWORD=

# Encryption: 32-byte AES-256 key as 64-char hex (preferred) or strict base64.
#   npm run keygen
# Paste the hex line only. No quotes, spaces, or hex: prefix.
# Do not rotate this key if encrypted backups already exist unless you keep the old key or migrate files.
BACKUP_ENCRYPTION_KEY=

# Storage
BACKUP_DIR=/var/data/backups
BACKUP_RETENTION_COUNT=7

# Timezone
APP_TIMEZONE=Asia/Aden

# Local Windows only; do not add this key to Render
# POSTGRES_BIN_DIR=C:\\Program Files\\PostgreSQL\\18\\bin

# Optional Resend settings
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional operational configuration
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
SESSION_MAX_AGE_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=30
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10
