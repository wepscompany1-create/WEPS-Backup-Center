generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BackupType {
  MANUAL
  SCHEDULED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  INTERRUPTED
}

enum IntegrityStatus {
  NOT_CHECKED
  VALID
  INVALID
}

enum BackupProgressStage {
  PREPARING
  DUMPING
  VALIDATING
  ENCRYPTING
  SAVING
  FINALIZING
}

enum RestoreProgressStage {
  PREPARING
  DECRYPTING
  VERIFYING
  CREATING_DATABASE
  RESTORING
  VALIDATING
  CLEANING_UP
  COMPLETED
}

enum ProductionRestoreMode {
  RESTORE_ONLY
  RESTORE_AND_CUTOVER
}

enum ProductionRestoreStatus {
  PENDING
  RUNNING
  AWAITING_CUTOVER
  AWAITING_EXTERNAL_CUTOVER
  SUCCESS
  FAILED
  INTERRUPTED
}

enum ProductionRestoreStage {
  PREPARING
  DECRYPTING
  VERIFYING
  CREATING_CANDIDATE
  RESTORING
  VALIDATING
  AWAITING_CUTOVER
  CUTOVER_RENAMING_ORIGINAL
  CUTOVER_RENAMING_CANDIDATE
  COMPLETED
  ROLLBACK_AVAILABLE
  AWAITING_EXTERNAL_CUTOVER
  COMPENSATING_RENAME
  ROLLBACK_REQUIRED
  DROPPING_PREVIOUS
  CLEANING_FAILED
}

enum ProductionRestoreEventLevel {
  INFO
  WARNING
  CRITICAL
}

enum AuditResult {
  SUCCESS
  FAILURE
  WARNING
}

enum NotificationEvent {
  BACKUP_SUCCESS
  BACKUP_FAILURE
  RESTORE_SUCCESS
  RESTORE_FAILURE
  INTEGRITY_FAILURE
  DISK_WARNING
  PRODUCTION_RESTORE_READY
  PRODUCTION_RESTORE_SUCCESS
  PRODUCTION_RESTORE_FAILURE
  PRODUCTION_RESTORE_CRITICAL
  PRODUCTION_PREVIOUS_DROPPED
  TEST
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model AdminUser {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  backups                           Backup[]
  restoreTests                      RestoreTest[]
  initiatedProductionRestores       ProductionRestore[] @relation("ProductionRestoreInitiatedBy")
  cutoverProductionRestores         ProductionRestore[] @relation("ProductionRestoreCutoverBy")
  previousDroppedProductionRestores ProductionRestore[] @relation("ProductionRestorePreviousDroppedBy")
  auditLogs                         AuditLog[]
}

model Backup {
  id                    String               @id @default(cuid())
  backupNumber          Int                  @unique
  type                  BackupType
  status                JobStatus
  progressStage         BackupProgressStage?
  integrityStatus       IntegrityStatus      @default(NOT_CHECKED)
  fileName              String?
  storagePath           String?
  originalDumpSizeBytes BigInt?
  encryptedSizeBytes    BigInt?
  sha256                String?
  encryptionIv          String?
  encryptionAuthTag     String?
  pgDumpVersion         String?
  postgresServerVersion String?
  startedAt             DateTime?
  completedAt           DateTime?
  durationMs            Int?
  errorCode             String?
  errorMessage          String?
  errorReferenceId      String?
  deletedAt             DateTime?
  initiatedById         String?
  initiatedBy           AdminUser?           @relation(fields: [initiatedById], references: [id])
  restoreTests          RestoreTest[]
  productionRestores    ProductionRestore[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([deletedAt])
}

model RestoreTest {
  id                  String                @id @default(cuid())
  backupId            String
  backup              Backup                @relation(fields: [backupId], references: [id])
  status              JobStatus
  progressStage       RestoreProgressStage?
  tempDatabaseName    String?
  startedAt           DateTime?
  completedAt         DateTime?
  durationMs          Int?
  integrityVerified   Boolean               @default(false)
  databaseCreated     Boolean               @default(false)
  restoreCompleted    Boolean               @default(false)
  validationCompleted Boolean               @default(false)
  tempDatabaseDropped Boolean               @default(false)
  tableCount          Int?
  validationSummary   String?
  errorCode           String?
  errorMessage        String?
  errorReferenceId    String?
  initiatedById       String?
  initiatedBy         AdminUser?            @relation(fields: [initiatedById], references: [id])
  productionRestores  ProductionRestore[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([tempDatabaseName])
}

model ProductionRestore {
  id                         String                   @id @default(cuid())
  backupId                   String
  backup                     Backup                   @relation(fields: [backupId], references: [id])
  requiredRestoreTestId      String
  requiredRestoreTest        RestoreTest              @relation(fields: [requiredRestoreTestId], references: [id])
  initiatedById              String
  initiatedBy                AdminUser                @relation("ProductionRestoreInitiatedBy", fields: [initiatedById], references: [id])
  cutoverById                String?
  cutoverBy                  AdminUser?               @relation("ProductionRestoreCutoverBy", fields: [cutoverById], references: [id])
  previousDroppedById        String?
  previousDroppedBy          AdminUser?               @relation("ProductionRestorePreviousDroppedBy", fields: [previousDroppedById], references: [id])
  mode                       ProductionRestoreMode
  status                     ProductionRestoreStatus
  progressStage              ProductionRestoreStage
  startedAt                  DateTime?
  candidateReadyAt           DateTime?
  cutoverStartedAt           DateTime?
  cutoverCompletedAt         DateTime?
  completedAt                DateTime?
  durationMs                 Int?
  originalDatabaseName       String
  candidateDatabaseName      String
  previousDatabaseName       String?
  integrityVerified          Boolean                  @default(false)
  candidateCreated           Boolean                  @default(false)
  restoreCompleted           Boolean                  @default(false)
  validationCompleted        Boolean                  @default(false)
  tableCount                 Int?
  validationSummary          Json?
  cutoverRequestedAt         DateTime?
  originalRenameStartedAt    DateTime?
  originalRenamedAt          DateTime?
  candidateRenameStartedAt   DateTime?
  cutoverCompleted           Boolean                  @default(false)
  compensationAttemptedAt    DateTime?
  compensationSucceededAt    DateTime?
  criticalState              String?
  rollbackAvailableUntil     DateTime?
  previousDroppedAt          DateTime?
  overwriteAcknowledgedAt    DateTime
  initialConfirmationAt      DateTime
  passwordReauthAt           DateTime
  cutoverConfirmationAt      DateTime?
  dropPreviousConfirmationAt DateTime?
  errorCode                  String?
  errorMessage               String?
  errorReferenceId           String?
  events                     ProductionRestoreEvent[]
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([backupId])
  @@index([candidateDatabaseName])
  @@index([previousDatabaseName])
}

model ProductionRestoreEvent {
  id                  String                      @id @default(cuid())
  productionRestoreId String
  productionRestore   ProductionRestore           @relation(fields: [productionRestoreId], references: [id], onDelete: Cascade)
  stage               ProductionRestoreStage
  level               ProductionRestoreEventLevel
  messageCode         String
  safeMetadata        Json?
  createdAt           DateTime                    @default(now())

  @@index([productionRestoreId, createdAt])
}

model AuditLog {
  id           String      @id @default(cuid())
  actorId      String?
  actor        AdminUser?  @relation(fields: [actorId], references: [id])
  action       String
  resourceType String?
  resourceId   String?
  result       AuditResult
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([action])
  @@index([result])
  @@index([createdAt])
}

model SystemSettings {
  id                                      String    @id
  scheduleEnabled                         Boolean   @default(true)
  backupIntervalDays                      Int       @default(2)
  backupLocalTime                         String    @default("03:00")
  timezone                                String    @default("Asia/Aden")
  nextScheduledBackupAt                   DateTime?
  notificationEmail                       String?
  notifyOnBackupSuccess                   Boolean   @default(true)
  notifyOnBackupFailure                   Boolean   @default(true)
  notifyOnRestoreSuccess                  Boolean   @default(true)
  notifyOnRestoreFailure                  Boolean   @default(true)
  notifyOnIntegrityFailure                Boolean   @default(true)
  productionRestoreMaintenanceEnabled     Boolean   @default(false)
  productionRestoreMaintenanceStart       String    @default("00:00")
  productionRestoreMaintenanceEnd         String    @default("23:59")
  productionRestoreRollbackRetentionHours Int       @default(24)
  createdAt                               DateTime  @default(now())
  updatedAt                               DateTime  @updatedAt
}

model NotificationLog {
  id           String             @id @default(cuid())
  event        NotificationEvent
  status       NotificationStatus
  toEmail      String
  subject      String
  errorCode    String?
  errorMessage String?
  resourceType String?
  resourceId   String?
  createdAt    DateTime           @default(now())

  @@index([createdAt])
  @@index([event])
}

model JobLock {
  name       String    @id
  holder     String?
  acquiredAt DateTime?
}
